# Porta da API
PORT=3333

# Banco de dados (SQLite local; o caminho é relativo à pasta prisma/)
DATABASE_URL="file:./dev.db"

# Troque por um valor longo e aleatório em produção
JWT_SECRET="troque-este-segredo-por-um-valor-longo-e-aleatorio"
JWT_EXPIRES_IN="8h"

# Origens permitidas no CORS (separadas por vírgula)
CORS_ORIGIN="http://localhost:5173"

# Opcional: URL que recebe um POST (JSON) quando um alerta de estoque é aberto.
# Compatível com webhooks do Discord/Slack, n8n, Zapier etc.
ALERT_WEBHOOK_URL=""

# Consulta de produtos por código de barras na Open Food Facts (API pública)
BARCODE_LOOKUP_ENABLED="true"

# Fuso horário usado em "hoje" e nos gráficos por dia
APP_TIMEZONE="America/Sao_Paulo"
